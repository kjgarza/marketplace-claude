{
  "description": "Surface pending tasks at session start; nudge to close/annotate active tasks before stopping.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tw-session-start.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tw-stop-check.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
