{
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"],
      "env": {}
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "${VHS_BERLIN_DB}"
      ],
      "env": {
        "VHS_BERLIN_DB": "${VHS_BERLIN_DB}"
      }
    }
  }
}
