@cli.command(epilog="""
Examples:
    # Search for resources
    {{cli_name}} search "machine learning"

    # Search with limit
    {{cli_name}} search "data" --limit 5
""")
@click.argument("query")
@click.option("--limit", default=10, help="Maximum number of results")
def search(query: str, limit: int):
    """Search for resources matching a query."""
    try:
        # TODO: Replace with your API call
        results = []  # your_api.search(query, limit=limit)

        result = CommandResult(
            success=True,
            message=f"Found {len(results)} results for '{query}'",
            context={
                "Query": query,
                "Total results": len(results),
                "First result ID": results[0]["id"] if results else None,
            },
            data=results,
            suggestions=[
                Suggestion(
                    command=f"{{{{cli_name}}}} show {results[0]['id']}" if results else "{{cli_name}} list",
                    description="View details" if results else "List all resources",
                    category="view" if results else "list"
                ),
                Suggestion(
                    command=f"{{{{cli_name}}}} search '{query}' --limit {limit * 2}",
                    description="Search with more results",
                    category="search"
                ),
            ]
        )
        output.success(result)

    except Exception as e:
        result = CommandResult(
            success=False,
            message=f"Search failed for '{query}'",
            error=ErrorDetail(
                what_went_wrong=str(e),
                how_to_fix=[
                    "Check your search query syntax",
                    "Verify your authentication",
                ],
                whats_next=[
                    Suggestion(command="{{cli_name}} list", description="List all resources instead", category="list"),
                ]
            )
        )
        output.error(result)


# =============================================================================
# Export Command
# =============================================================================

@cli.command(epilog="""
Examples:
    # Export as JSON
    {{cli_name}} export abc123 --format json

    # Export as CSV
    {{cli_name}} export abc123 --format csv

    # Export to file
    {{cli_name}} export abc123 --format json --output data.json
""")
@click.argument("resource_id")
@click.option("--format", "fmt", default="json", type=click.Choice(["json", "csv"]), help="Export format")
@click.option("--output", "-o", "output_file", help="Output file path")
def export(resource_id: str, fmt: str, output_file: str):
    """Export resource data to a file."""
    try:
        # TODO: Replace with your export logic
        data = {}  # your_api.export(resource_id, format=fmt)

        if output_file:
            # Write to file
            with open(output_file, "w") as f:
                f.write(str(data))
            message = f"Exported to '{output_file}'"
        else:
            # Print to stdout
            console.print_json(data=data) if fmt == "json" else console.print(data)
            message = f"Exported {resource_id} as {fmt.upper()}"

        result = CommandResult(
            success=True,
            message=message,
            context={
                "Resource ID": resource_id,
                "Format": fmt,
                "Output": output_file or "stdout",
            },
            suggestions=[
                Suggestion(
                    command=f"{{{{cli_name}}}} show {resource_id}",
                    description="View resource details",
                    category="view"
                ),
                Suggestion(
                    command="{{cli_name}} list",
                    description="List other resources",
                    category="list"
                ),
            ]
        )
        output.success(result)

    except Exception as e:
        result = CommandResult(
            success=False,
            message=f"Export failed for '{resource_id}'",
            error=ErrorDetail(
                what_went_wrong=str(e),
                how_to_fix=[
                    "Verify the resource ID exists",
                    "Check write permissions for output file",
                ],
                whats_next=[
                    Suggestion(command=f"{{{{cli_name}}}} show {resource_id}", description="Verify resource exists", category="view"),
                ]
            )
        )
        output.error(result)


