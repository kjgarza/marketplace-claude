"""Main CLI entry point.

This is the entry point for the CLI application.
All commands should follow the 'Every Output is a Prompt' pattern.
"""

import click
from rich.console import Console

from .models.responses import CommandResult, Suggestion, ErrorDetail
from .output.conversational import ConversationalOutput

# Initialize Rich console and conversational output
console = Console()
output = ConversationalOutput(console)


@click.group()
@click.version_option()
def cli():
    """{{description}}

    This CLI provides AI-friendly output designed for agentic coding environments.
    Every command provides context and suggests next steps.

    Examples:
        {{cli_name}} list
        {{cli_name}} show RESOURCE_ID
        {{cli_name}} search "query"
        {{cli_name}} export RESOURCE_ID --format json
    """
    pass


# =============================================================================
# List Command
# =============================================================================

@cli.command(epilog="""
Examples:
    # List all resources
    {{cli_name}} list

    # List with limit
    {{cli_name}} list --limit 5

    # List only your resources
    {{cli_name}} list --mine
""")
@click.option("--limit", default=10, help="Maximum number of results")
@click.option("--mine", is_flag=True, help="Only show resources you own")
def list(limit: int, mine: bool):
    """List available resources."""
    try:
        # TODO: Replace with your API call
        resources = []  # your_api.list_resources(limit=limit, mine=mine)

        result = CommandResult(
            success=True,
            message=f"Found {len(resources)} resources",
            context={
                "Total resources": len(resources),
                "Limit": limit,
                "Filter": "mine" if mine else "all",
            },
            data=resources,
            suggestions=[
                Suggestion(
                    command=f"{{{{cli_name}}}} show {resources[0]['id']}" if resources else "{{cli_name}} search 'query'",
                    description="View resource details" if resources else "Search for resources",
                    category="view" if resources else "search"
                ),
                Suggestion(
                    command="{{cli_name}} list --limit 20",
                    description="Show more results",
                    category="list"
                ),
            ]
        )
        output.success(result)

    except Exception as e:
        result = CommandResult(
            success=False,
            message="Failed to list resources",
            error=ErrorDetail(
                what_went_wrong=str(e),
                how_to_fix=[
                    "Check your network connection",
                    "Verify your authentication credentials",
                ],
                whats_next=[
                    Suggestion(command="{{cli_name}} auth test", description="Test authentication", category="auth"),
                ]
            )
        )
        output.error(result)


# =============================================================================
# Show Command
# =============================================================================

@cli.command(epilog="""
Examples:
    # Show resource details
    {{cli_name}} show abc123

    # Show with JSON output
    {{cli_name}} show abc123 --json
""")
@click.argument("resource_id")
@click.option("--json", "as_json", is_flag=True, help="Output as JSON")
def show(resource_id: str, as_json: bool):
    """Show details for a specific resource."""
    try:
        # TODO: Replace with your API call
        resource = {}  # your_api.get_resource(resource_id)

        if as_json:
            console.print_json(data=resource)
            return

        result = CommandResult(
            success=True,
            message=f"Resource details for '{resource.get('name', resource_id)}'",
            context={
                "Resource ID": resource_id,
                "Name": resource.get("name", "Unknown"),
                "Created": resource.get("created_at", "Unknown"),
                "Updated": resource.get("updated_at", "Unknown"),
            },
            suggestions=[
                Suggestion(
                    command=f"{{{{cli_name}}}} export {resource_id} --format json",
                    description="Export resource data",
                    category="export"
                ),
                Suggestion(
                    command="{{cli_name}} list",
                    description="List all resources",
                    category="list"
                ),
            ]
        )
        output.success(result)

    except Exception as e:
        result = CommandResult(
            success=False,
            message=f"Failed to show resource '{resource_id}'",
            error=ErrorDetail(
                what_went_wrong=str(e),
                how_to_fix=[
                    "Verify the resource ID is correct",
                    "Check if you have permission to access this resource",
                ],
                whats_next=[
                    Suggestion(command="{{cli_name}} list", description="List available resources", category="list"),
                    Suggestion(command="{{cli_name}} search 'query'", description="Search for resources", category="search"),
                ]
            )
        )
        output.error(result)


