{
  "description": "Senior Developer Assistant hooks for code quality, security reviews, and workflow enhancements",
  "hooks": {
    "on_file_open": [
      {
        "matcher": "*auth*.{js,ts,py,java,go}",
        "hooks": [
          {
            "type": "prompt",
            "message": "This appears to be authentication code. Would you like a security review?",
            "confirmCommand": "/code-review --focus=security"
          }
        ]
      }
    ],
    "on_git_commit": [
      {
        "matcher": "*.{js,ts,jsx,tsx,py,java,go}",
        "hooks": [
          {
            "type": "prompt",
            "message": "Senior Developer: Run code review before committing?",
            "confirmCommand": "/code-review"
          }
        ]
      }
    ],
    "on_error": [
      {
        "matcher": "(performance|slow|timeout|memory)",
        "hooks": [
          {
            "type": "notification",
            "message": "Performance issue detected. Senior Developer can help optimize with /code-review --focus=performance"
          }
        ]
      }
    ],
    "on_chat_message": [
      {
        "matcher": "(architecture|system design|scalability|how should I design)",
        "hooks": [
          {
            "type": "command",
            "command": "/system-design",
            "autoExecute": false,
            "suggestion": true
          }
        ]
      },
      {
        "matcher": "(refactor|legacy|technical debt|code smell)",
        "hooks": [
          {
            "type": "command",
            "command": "/refactor-strategy",
            "autoExecute": false,
            "suggestion": true
          }
        ]
      }
    ],
    "on_project_open": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "notification",
            "message": "Senior Developer Assistant loaded. Commands: /architecture-review, /code-review, /system-design, /refactor-strategy, /technical-debt-audit",
            "dismissible": true,
            "showOnce": true
          }
        ]
      }
    ]
  }
}
